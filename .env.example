# Provider: `meta` (default) or `twilio`. Twilio's WhatsApp Sandbox needs no card.
WHATSAPP_PROVIDER=meta

# WhatsApp Cloud API (Meta) — used when WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp — used when WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The sandbox reuses one number, so choose the clinic it belongs to.
TWILIO_CLINIC_ID=

# HighLevel (agency Private Integration Token). Unset = local mode, no sync.
# Free demo without an account: run `npm run ghl:mock` and set
#   GHL_API_TOKEN=emulator
#   GHL_BASE_URL=http://127.0.0.1:4010
GHL_API_TOKEN=
GHL_BASE_URL=https://services.leadconnectorhq.com

# Local demo database (defaults to ./data/frontdesk.db)
DB_PATH=
